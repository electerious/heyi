{
  "name": "heyi",
  "version": "4.0.0",
  "description": "CLI tool to execute AI prompts with flexible output formatting",
  "keywords": [
    "ai",
    "cli",
    "openrouter",
    "llm",
    "prompt"
  ],
  "homepage": "https://github.com/electerious/heyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electerious/heyi.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "heyi": "bin/index.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "eslint": "eslint \"**/*.js\"",
    "format": "npm run eslint -- --fix && npm run prettier -- --write",
    "lint": "npm run eslint && npm run prettier -- --check",
    "prettier": "prettier --ignore-path .gitignore \"**/*.{js,json,md,yml}\"",
    "start": "./bin/index.js",
    "test": "npm run lint && node --test"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.66",
    "commander": "^15.0.0",
    "puppeteer": "^25.7.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electerious/eslint-config": "^6.0.0-rc.3",
    "@electerious/prettier-config": "^4.0.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "authors": [
    "Tobias Reich <tobias@electerious.com>"
  ]
}
